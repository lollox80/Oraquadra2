# Esempio dei segreti usati da oraquadra2_homeassistant.yaml (ESPHome).
# Copialo come secrets.yaml accanto al file (o metti queste voci nel secrets.yaml di ESPHome su Home Assistant)
# e scrivi i valori veri. secrets.yaml e' escluso da Git (.gitignore): non va mai committato.
wifi_ssid: "NOME_DELLA_RETE_WIFI"
wifi_password: "PASSWORD_DELLA_RETE_WIFI"
oraquadra2_ap_password: "PASSWORD_RETE_DI_EMERGENZA"
oraquadra2_ota_password: "PASSWORD_OTA"
oraquadra2_api_key: "CHIAVE_API_BASE64_DI_44_CARATTERI"
oraquadra2_web_password: "PASSWORD_WEB_SERVER"
