// ============================================================================
//  mqtt_secrets.h.example  -  Template per le credenziali del broker MQTT
//
//  USO: copia questo file come "mqtt_secrets.h" (stessa cartella dello sketch)
//  e inserisci i TUOI valori reali. "mqtt_secrets.h" e' nel .gitignore e non
//  verra' committato: le credenziali restano solo sul tuo PC (e in EEPROM).
//
//  Il file e' OPZIONALE: senza, il firmware usa i placeholder definiti in
//  mqtt_oraquadra.h e il broker si configura dal pannello web dell'orologio
//  (/setMqttSettings), con salvataggio in EEPROM.
// ============================================================================
#pragma once

#define MQTT_SERVER_DEFAULT     "192.168.1.100"   // IP o hostname del broker
#define MQTT_PORT_DEFAULT       1883              // Porta broker (1883 standard)
#define MQTT_USER_DEFAULT       "mqtt"            // Utente broker
#define MQTT_PASSWORD_DEFAULT   "CHANGE_ME"       // Password broker
#define MQTT_BASE_TOPIC_DEFAULT "oraquadra2"      // Topic base
#define MQTT_DEVICE_NAME_DEFAULT "OraQuadra2"     // Nome dispositivo in HA
